# General UID/GIU and Timezone
TZ=America/Argentina/Buenos_Aires
PUID=1000
PGID=1000

# Host paths for persistent storage — change once here to relocate the whole stack
# DATA_DIR holds downloads/media shared across the *arr apps and qbittorrent
# CONFIG_DIR is the base folder under which each service keeps its own config subfolder
DATA_DIR=./data
CONFIG_DIR=.

# Homarr requires a 64-char hex secret; generate with: openssl rand -hex 32
HOMARR_SECRET_ENCRYPTION_KEY=<your_secret_key>

# Toggles the VPN. Set to "vpn" to route qbittorrent+prowlarr through gluetun,
# or "no-vpn" to run them directly on servarrnetwork (gluetun is not started).
# COMPOSE_PROFILES is read natively by docker compose.
COMPOSE_PROFILES=vpn

# Input your VPN provider and type here

VPN_SERVICE_PROVIDER=protonvpn
VPN_TYPE=wireguard
#FIREWALL_VPN_INPUT_PORTS=39526
VPN_PORT_FORWARDING=on
FIREWALL_VPN_INPUT_PORTS=51536
# Copy all these varibles from your generated configuration file
WIREGUARD_PUBLIC_KEY=<wireguardPublicKey>
WIREGUARD_PRIVATE_KEY=<wireguardPrivateKey>
WIREGUARD_ADDRESSES=10.2.0.2

# Optional location varbiles, comma seperated list,no spaces after commas, make sure it matches the config you created
#SERVER_COUNTRIES=Canada
#SERVER_CITIES=Vancouver 

# Heath check duration
HEALTH_VPN_DURATION_INITIAL=120s
